# LeadNexus AI X - Environment Configuration

APP_NAME="LeadNexus AI X"
APP_ENV="development"
DEBUG=true

# API Server
API_HOST="0.0.0.0"
API_PORT=8000

# Database
# In development, SQLite Async is supported out of the box. In production, use PostgreSQL asyncpg.
DATABASE_URL="sqlite+aiosqlite:///./leadnexus.db"
SYNC_DATABASE_URL="sqlite:///./leadnexus.db"

# PostgreSQL (Docker / Production)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="leadnexus"
POSTGRES_USER="leadnexus_user"
POSTGRES_PASSWORD="leadnexus_secure_password"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT Authentication
JWT_SECRET_KEY="leadnexus-super-secret-development-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Logging
LOG_LEVEL="INFO"

